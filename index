<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>OneTiers — Premier Minecraft Tierlist</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- 3D Skin Viewer Library -->
    <script src="https://bs-community.github.io/skinview3d/js/skinview3d.bundle.js"></script>
    <style>
        * { font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: #070708; color: #f8fafc; overflow-x: hidden; }
        
        .glass-panel {
            background: rgba(18, 18, 20, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .glass-panel-hover:hover {
            background: rgba(28, 28, 32, 0.85);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.8);
        }
        
        /* Tier badges */
        .tier-badge {
            font-size: 0.65rem;
            font-weight: 800;
            padding: 3px 7px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .tier-ht1 { background: #ffffff; color: #000; font-weight: 900; box-shadow: 0 0 12px rgba(255,255,255,0.4); }
        .tier-lt1 { background: #e2e8f0; color: #0f172a; }
        .tier-ht2 { background: #cbd5e1; color: #0f172a; }
        .tier-lt2 { background: #94a3b8; color: #0f172a; }
        .tier-ht3 { background: #64748b; color: #fff; }
        .tier-lt3 { background: #475569; color: #fff; }
        .tier-ht4 { background: #334155; color: #cbd5e1; }
        .tier-lt4 { background: #1e293b; color: #94a3b8; border: 1px solid rgba(255,255,255,0.1); }
        .tier-ht5 { background: #171c26; color: #64748b; border: 1px solid rgba(255,255,255,0.08); }
        .tier-lt5 { background: #0f1218; color: #475569; border: 1px solid rgba(255,255,255,0.05); }

        .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(10, 10, 12, 0.5); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 99px; }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.98) translateY(10px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        .animate-fade-in { animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-white selection:text-black pb-20 md:pb-0">

    <!-- Canvas Background Particles -->
    <canvas id="bgParticles" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <!-- Telegram Notification (Mobile Adapted: Bottom Right / Center on small screens) -->
    <div id="telegramWidget" class="fixed bottom-20 md:bottom-5 right-3 left-3 sm:left-auto sm:right-5 z-50 animate-fade-in max-w-sm">
        <div class="glass-panel p-3.5 sm:p-4 rounded-3xl border border-white/15 shadow-2xl flex items-center gap-3 relative overflow-hidden group">
            <button onclick="closeTelegramWidget()" class="absolute top-2.5 right-2.5 text-slate-500 hover:text-white text-xs w-6 h-6 rounded-full bg-white/5 flex items-center justify-center transition">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="w-10 h-10 rounded-2xl bg-[#2AABEE]/20 border border-[#2AABEE]/40 flex items-center justify-center text-[#2AABEE] text-lg shrink-0 shadow-lg shadow-[#2AABEE]/20">
                <i class="fa-brands fa-telegram"></i>
            </div>
            <div class="space-y-1 pr-3">
                <div class="text-xs font-black text-white flex items-center gap-1.5">
                    <span data-i18n="tgTitle">Telegram Канал</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#2AABEE] animate-pulse"></span>
                </div>
                <p class="text-[10px] sm:text-[11px] text-slate-300 leading-snug" data-i18n="tgDesc">
                    Подписывайтесь на наш телеграм канал <span class="font-bold text-white">@onetiers</span>
                </p>
                <a href="https://t.me/onetiers" target="_blank" class="inline-flex items-center gap-1.5 bg-[#2AABEE] hover:bg-[#229ED9] text-white text-[10px] sm:text-[11px] font-extrabold px-3 py-1 rounded-xl transition-all duration-300 shadow-md shadow-[#2AABEE]/20 active:scale-95 mt-1">
                    <span data-i18n="tgBtn">Подписаться</span>
                    <i class="fa-solid fa-arrow-right text-[9px]"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Header Navbar -->
    <header class="glass-panel sticky top-0 z-40 border-b border-white/10 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-2 sm:gap-4 relative z-10">
            
            <div class="flex items-center gap-2.5 sm:gap-3.5 cursor-pointer group shrink-0" onclick="navigateTo('leaderboard')">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-white/20 bg-black flex items-center justify-center p-1.5 shadow-lg shadow-black/80 group-hover:scale-105 transition-transform duration-300">
                    <svg viewBox="0 0 500 500" class="w-full h-full text-white fill-current">
                        <path d="M250 50 C 140 50, 50 140, 50 250 C 50 360, 140 450, 250 450 C 310 450, 365 425, 400 380 M 130 260 C 120 220, 135 180, 160 160 C 150 200, 160 220, 185 200 C 165 240, 170 260, 190 250" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"/>
                        <text x="300" y="300" font-family="'Plus Jakarta Sans', cursive, sans-serif" font-size="160" font-weight="900" font-style="italic" text-anchor="middle" fill="currentColor">One</text>
                    </svg>
                </div>
                <div>
                    <h1 class="text-base sm:text-xl font-black tracking-widest text-white flex items-center gap-1.5">
                        ONETIERS
                        <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
                    </h1>
                    <p class="text-[9px] sm:text-[10px] font-semibold text-slate-400 tracking-widest uppercase">Official Tierlist</p>
                </div>
            </div>

            <!-- Desktop Nav Buttons -->
            <div class="hidden md:flex items-center gap-1 bg-white/[0.03] p-1.5 rounded-2xl border border-white/5">
                <button onclick="navigateTo('leaderboard')" id="nav-leaderboard" class="px-5 py-2 rounded-xl text-xs font-bold transition-all duration-300 flex items-center gap-2">
                    <i class="fa-solid fa-trophy"></i>
                    <span data-i18n="navLeaderboard">Лидерборд</span>
                </button>
                <button onclick="navigateTo('guide')" id="nav-guide" class="px-5 py-2 rounded-xl text-xs font-bold transition-all duration-300 flex items-center gap-2">
                    <i class="fa-solid fa-book-bookmark"></i>
                    <span data-i18n="navGuide">Гайд</span>
                </button>
                <button onclick="toggleDiscordModal()" class="px-5 py-2 rounded-xl text-xs font-bold transition-all duration-300 flex items-center gap-2 text-slate-400 hover:text-white hover:bg-white/5">
                    <i class="fa-brands fa-discord"></i>
                    <span>Discord</span>
                </button>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Search Input -->
                <div class="relative w-28 sm:w-48">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
                    <input type="text" id="searchInput" oninput="handleSearch(this.value)" placeholder="Поиск..." 
                        class="w-full bg-slate-950/80 border border-white/10 rounded-xl pl-8 pr-2 py-1.5 sm:py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-white/40 transition-all">
                    <div id="searchResults" class="hidden absolute top-full left-0 right-0 mt-2 glass-panel rounded-2xl border border-white/10 shadow-2xl z-50 max-h-60 overflow-y-auto custom-scrollbar"></div>
                </div>

                <!-- Language Switcher Button -->
                <button onclick="toggleLanguage()" id="langSwitchBtn" class="flex items-center gap-1 bg-white/5 hover:bg-white/10 border border-white/10 text-white text-xs font-extrabold px-2.5 py-1.5 sm:py-2 rounded-xl transition active:scale-95">
                    <i class="fa-solid fa-globe text-slate-400 text-[11px]"></i>
                    <span id="currentLangLabel">RU</span>
                </button>

                <!-- Auth Container -->
                <div id="authContainer">
                    <button onclick="openAuthModal()" class="flex items-center gap-1.5 bg-white hover:bg-slate-200 text-black text-xs font-extrabold px-3 sm:px-4 py-1.5 sm:py-2.5 rounded-xl transition-all shadow-lg shadow-white/10 active:scale-95">
                        <i class="fa-brands fa-discord text-sm"></i>
                        <span data-i18n="login" class="hidden sm:inline">Войти</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Gamemode Navigation (Horizontal Scroll on Mobile) -->
    <nav id="gamemodeNav" class="border-b border-white/5 bg-black/40 backdrop-blur-md sticky top-[57px] sm:top-[65px] z-30 overflow-x-auto custom-scrollbar">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 flex space-x-2 min-w-max py-2 relative z-10" id="categoryTabs"></div>
    </nav>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-8 relative z-10">
        
        <!-- 1. LEADERBOARD VIEW -->
        <div id="view-leaderboard" class="space-y-4 sm:space-y-6 animate-fade-in">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 glass-panel p-4 sm:p-8 rounded-3xl border border-white/10">
                <div>
                    <h2 id="currentCategoryTitle" class="text-xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
                        Overall Leaderboard
                    </h2>
                    <p id="currentCategoryDesc" class="text-[11px] sm:text-xs text-slate-400 mt-0.5" data-i18n="overallDesc">
                        Общий рейтинг сильнейших игроков по всем дисциплинам OneTiers
                    </p>
                </div>
                <div class="flex items-center gap-3" id="headerRightAction">
                    <div class="bg-white/5 border border-white/10 px-3 py-1.5 sm:px-4 sm:py-2 rounded-2xl text-[11px] sm:text-xs font-bold text-slate-300">
                        <span data-i18n="totalPlayers">Игроков в топе:</span> <span id="totalPlayersCount" class="text-white font-black">0</span>
                    </div>
                </div>
            </div>

            <!-- Table View (For Overall) -->
            <div id="tableViewContainer" class="glass-panel rounded-3xl border border-white/10 overflow-hidden shadow-2xl transition-all duration-300">
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-white/10 bg-black/60 text-[10px] sm:text-[11px] font-black text-slate-400 uppercase tracking-widest">
                                <th class="p-3 sm:p-5 w-14 sm:w-20 text-center" data-i18n="thRank">Ранг</th>
                                <th class="p-3 sm:p-5" data-i18n="thPlayer">Игрок</th>
                                <th class="p-3 sm:p-5 text-center" data-i18n="thScore">Overall Score</th>
                                <th class="p-3 sm:p-5 text-right hidden sm:table-cell" data-i18n="thTiers">Тиры по дисциплинам</th>
                            </tr>
                        </thead>
                        <tbody id="leaderboardBody" class="divide-y divide-white/5 text-xs sm:text-sm"></tbody>
                    </table>
                </div>
            </div>

            <!-- Columns View Tier 1 - Tier 5 (1 col on Mobile, 5 cols on PC) -->
            <div id="columnsViewContainer" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-3 sm:gap-4 transition-all duration-300"></div>
        </div>

        <!-- 2. GUIDE VIEW -->
        <div id="view-guide" class="hidden space-y-6 sm:space-y-10 max-w-5xl mx-auto animate-fade-in">
            <div class="text-center space-y-2 py-2">
                <span class="px-3 py-0.5 bg-white/5 border border-white/10 text-slate-300 rounded-full text-[10px] font-black tracking-widest uppercase" data-i18n="guideBadge">Инструкция</span>
                <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight" data-i18n="guideTitle">Как пройти тир-тест?</h2>
                <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto" data-i18n="guideSubtitle">Присоединяйтесь к нашим Discord-серверам для прохождения квалификации и получения официального тира.</p>
            </div>

            <div class="space-y-3">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-400" data-i18n="guideStep1Title">1. Активные Discord серверы</h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4" id="guideDiscordGrid"></div>
            </div>

            <div class="space-y-3">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-400" data-i18n="guideStep2Title">2. Шаги прохождения</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
                    <div class="glass-panel p-5 rounded-3xl space-y-2 border border-white/5 glass-panel-hover">
                        <div class="w-8 h-8 rounded-xl bg-white text-black font-black flex items-center justify-center text-sm">1</div>
                        <h4 class="font-extrabold text-white text-sm" data-i18n="step1Header">Привязка аккаунта</h4>
                        <p class="text-xs text-slate-400 leading-relaxed" data-i18n="step1Desc">Зайдите в Discord выбранного кита и введите команду /link, затем подтвердите ник в игре через /verify.</p>
                    </div>
                    <div class="glass-panel p-5 rounded-3xl space-y-2 border border-white/5 glass-panel-hover">
                        <div class="w-8 h-8 rounded-xl bg-white text-black font-black flex items-center justify-center text-base">2</div>
                        <h4 class="font-extrabold text-white text-sm" data-i18n="step2Header">Подача заявки</h4>
                        <p class="text-xs text-slate-400 leading-relaxed" data-i18n="step2Desc">Откройте тикет на тестирование в канале тестирования Discord-сервера и дождитесь свободного тиртестера.</p>
                    </div>
                    <div class="glass-panel p-5 rounded-3xl space-y-2 border border-white/5 glass-panel-hover">
                        <div class="w-8 h-8 rounded-xl bg-white text-black font-black flex items-center justify-center text-base">3</div>
                        <h4 class="font-extrabold text-white text-sm" data-i18n="step3Header">Проведение дуэли</h4>
                        <p class="text-xs text-slate-400 leading-relaxed" data-i18n="step3Desc">Сыграйте тестовый поединок против тестера. По итогам боя вам будет присвоен официальный тир.</p>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <h3 class="text-xs font-black uppercase tracking-widest text-slate-400" data-i18n="faqTitle">3. Вопросы и ответы (FAQ)</h3>
                <div class="space-y-2 sm:space-y-3" id="faqAccordion"></div>
            </div>
        </div>

        <!-- 3. USER PROFILE VIEW -->
        <div id="view-profile" class="hidden max-w-3xl mx-auto space-y-4 sm:space-y-6 animate-fade-in">
            <div class="glass-panel p-5 sm:p-8 rounded-3xl flex flex-col sm:flex-row items-center gap-4 sm:gap-6 border border-white/10 shadow-2xl relative overflow-hidden">
                <img id="userAvatar" src="" class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl border-2 border-white/20 shadow-xl bg-black object-cover">
                <div class="space-y-1 sm:space-y-2 text-center sm:text-left flex-1">
                    <h2 id="userName" class="text-2xl sm:text-3xl font-black text-white tracking-tight"></h2>
                    <p id="userDiscordId" class="text-xs font-mono text-slate-400"></p>
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/5 border border-white/10 text-slate-200 text-xs rounded-lg font-bold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span data-i18n="authDiscordTag">Авторизован через Discord</span>
                    </div>
                </div>
                <button onclick="logoutDiscord()" class="bg-white/5 hover:bg-white/10 text-red-400 border border-red-500/20 px-4 py-2 rounded-xl text-xs font-bold transition active:scale-95" data-i18n="logout">
                    Выйти
                </button>
            </div>

            <div id="userProfileDetails" class="glass-panel p-5 sm:p-8 rounded-3xl space-y-4 sm:space-y-6 border border-white/10"></div>
        </div>

        <!-- Auth Code Modal -->
        <div id="authModal" class="fixed inset-0 bg-black/90 backdrop-blur-md z-50 hidden flex items-center justify-center p-3 sm:p-4">
            <div class="glass-panel border border-white/15 rounded-3xl max-w-md w-full p-5 sm:p-8 shadow-2xl relative text-center space-y-4 sm:space-y-6 animate-fade-in max-h-[90vh] overflow-y-auto">
                <button onclick="closeAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white w-8 h-8 rounded-full bg-white/5 flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>

                <div class="w-12 h-12 rounded-full border border-white/20 bg-black flex items-center justify-center p-2 mx-auto shadow-xl">
                    <svg viewBox="0 0 500 500" class="w-full h-full text-white fill-current">
                        <path d="M250 50 C 140 50, 50 140, 50 250 C 50 360, 140 450, 250 450 C 310 450, 365 425, 400 380 M 130 260 C 120 220, 135 180, 160 160 C 150 200, 160 220, 185 200 C 165 240, 170 260, 190 250" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"/>
                        <text x="300" y="300" font-family="'Plus Jakarta Sans', cursive, sans-serif" font-size="160" font-weight="900" font-style="italic" text-anchor="middle" fill="currentColor">One</text>
                    </svg>
                </div>

                <div class="space-y-1">
                    <h3 class="text-xl sm:text-2xl font-black text-white" data-i18n="modalAuthTitle">Вход через Discord</h3>
                    <p class="text-xs text-slate-400" data-i18n="modalAuthSub">Введите команду на любом из наших Discord-серверов:</p>
                </div>

                <div class="bg-black/80 border border-white/10 p-4 rounded-2xl shadow-inner">
                    <div class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1" data-i18n="modalCodeTag">Одноразовый код</div>
                    <div id="authCodeDisplay" class="text-2xl sm:text-3xl font-mono font-black text-white tracking-widest select-all">
                        <i class="fa-solid fa-spinner fa-spin text-lg"></i>
                    </div>
                </div>

                <div class="bg-white/[0.02] p-3.5 rounded-2xl border border-white/5 text-left text-xs space-y-2">
                    <div class="text-slate-300 font-bold flex items-center gap-2">
                        <i class="fa-solid fa-terminal text-white"></i> <span data-i18n="modalInst">Инструкция:</span>
                    </div>
                    <ol class="list-decimal list-inside text-slate-400 space-y-1 leading-relaxed text-[11px] sm:text-xs">
                        <li data-i18n="modalStep1">Зайдите в наш Discord сервер</li>
                        <li><span data-i18n="modalStep2">Наберите в чате:</span> <code class="text-white font-mono font-bold bg-white/10 px-1 py-0.5 rounded border border-white/10 text-[10px]" id="authCommandText">/site-auth OT-XXXXXX</code></li>
                        <li data-i18n="modalStep3">Страница автоматически авторизуется</li>
                    </ol>
                </div>

                <div class="text-[10px] sm:text-[11px] text-slate-500 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-circle-notch fa-spin text-white"></i>
                    <span data-i18n="modalWaiting">Ожидание ввода команды в Discord...</span>
                </div>
            </div>
        </div>

        <!-- Player Profile Modal -->
        <div id="playerModal" class="fixed inset-0 bg-black/90 backdrop-blur-md z-50 hidden flex items-center justify-center p-3 sm:p-4">
            <div class="glass-panel border border-white/15 rounded-3xl max-w-2xl w-full overflow-hidden shadow-2xl relative animate-fade-in max-h-[90vh] overflow-y-auto custom-scrollbar">
                <button onclick="closePlayerModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white w-8 h-8 rounded-full bg-white/5 flex items-center justify-center transition z-10">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                <div id="playerModalContent" class="p-5 sm:p-8"></div>
            </div>
        </div>

        <!-- Discords Modal -->
        <div id="discordModal" class="fixed inset-0 bg-black/90 backdrop-blur-md z-50 hidden flex items-center justify-center p-3 sm:p-4">
            <div class="glass-panel border border-white/15 rounded-3xl max-w-lg w-full p-5 sm:p-8 shadow-2xl relative space-y-4 sm:space-y-5 animate-fade-in">
                <button onclick="toggleDiscordModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white w-8 h-8 rounded-full bg-white/5 flex items-center justify-center transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full border border-white/20 bg-black flex items-center justify-center p-1.5">
                        <svg viewBox="0 0 500 500" class="w-full h-full text-white fill-current">
                            <path d="M250 50 C 140 50, 50 140, 50 250 C 50 360, 140 450, 250 450 C 310 450, 365 425, 400 380 M 130 260 C 120 220, 135 180, 160 160 C 150 200, 160 220, 185 200 C 165 240, 170 260, 190 250" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"/>
                            <text x="300" y="300" font-family="'Plus Jakarta Sans', cursive, sans-serif" font-size="160" font-weight="900" font-style="italic" text-anchor="middle" fill="currentColor">One</text>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg sm:text-xl font-black text-white">Discord Серверы</h3>
                        <p class="text-[11px] text-slate-400" data-i18n="discordModalSub">Выберите нужный кит для подключения</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-2.5 max-h-80 overflow-y-auto pr-1 custom-scrollbar" id="discordList"></div>
            </div>
        </div>

    </main>

    <!-- Mobile Bottom Navigation Bar (Visible only on smartphones) -->
