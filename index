                            ${items.length === 0 ? `<div class="text-xs text-slate-600 text-center py-6 font-semibold">${I18N[currentLang].noPlayers}</div>` : ''}
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function openAuthModal() {
            document.getElementById('authModal').classList.remove('hidden');
            document.getElementById('authCodeDisplay').innerHTML = `<i class="fa-solid fa-spinner fa-spin text-xl"></i>`;

            try {
                const res = await fetch(`${API_BASE}/auth/code`, { method: 'POST' });
                const data = await res.json();
                currentAuthCode = data.code;
                document.getElementById('authCodeDisplay').innerText = data.code;
                document.getElementById('authCommandText').innerText = `/site-auth ${data.code}`;

                if (authPollInterval) clearInterval(authPollInterval);
                authPollInterval = setInterval(pollAuthStatus, 2000);
            } catch (e) {
                document.getElementById('authCodeDisplay').innerText = "ERROR";
            }
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
            if (authPollInterval) clearInterval(authPollInterval);
        }

        async function pollAuthStatus() {
            if (!currentAuthCode) return;
            try {
                const res = await fetch(`${API_BASE}/auth/check?code=${currentAuthCode}`);
                const data = await res.json();

                if (data.status === 'confirmed' && data.player) {
                    clearInterval(authPollInterval);
                    currentUser = {
                        username: data.player.nickname || `User_${data.player.discordId}`,
                        id: data.player.discordId,
                        avatar: `https://mc-heads.net/avatar/${data.player.nickname || 'Steve'}/64`,
                        playerData: data.player
                    };
                    localStorage.setItem('onetiers_user', JSON.stringify(currentUser));
                    closeAuthModal();
                    updateAuthUI();
                    navigateTo('profile');
                }
            } catch (e) {}
        }

        function checkAuth() {
            const saved = localStorage.getItem('onetiers_user');
            if (saved) {
                currentUser = JSON.parse(saved);
                updateAuthUI();
            }
        }

        function logoutDiscord() {
            localStorage.removeItem('onetiers_user');
            currentUser = null;
            updateAuthUI();
            navigateTo('leaderboard');
        }

        function updateAuthUI() {
            const container = document.getElementById('authContainer');
            if (currentUser) {
                container.innerHTML = `
                    <button onclick="navigateTo('profile')" class="flex items-center gap-2 bg-white/5 hover:bg-white/10 p-1 sm:p-1.5 sm:pr-3.5 rounded-xl border border-white/10 transition">
                        <img src="${currentUser.avatar}" class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-black" onerror="this.src='https://crafthead.net/helm/Steve/24'">
                        <span class="text-xs font-bold text-white hidden sm:inline">${currentUser.username}</span>
                    </button>
                `;
                document.getElementById('userName').innerText = currentUser.username;
                document.getElementById('userDiscordId').innerText = `Discord ID: ${currentUser.id}`;
                document.getElementById('userAvatar').src = currentUser.avatar;
                
                renderUserProfileData(currentUser.id);
            } else {
                container.innerHTML = `
                    <button onclick="openAuthModal()" class="flex items-center gap-1.5 bg-white hover:bg-slate-200 text-black text-xs font-extrabold px-3 sm:px-4 py-1.5 sm:py-2.5 rounded-xl transition-all shadow-lg shadow-white/10 active:scale-95">
                        <i class="fa-brands fa-discord text-sm"></i>
                        <span class="hidden sm:inline">${I18N[currentLang].login}</span>
                    </button>
                `;
            }
        }

        async function renderUserProfileData(discordId) {
            const container = document.getElementById('userProfileDetails');
            const data = await fetchPlayerData(discordId);
            
            if (!data) {
                container.innerHTML = `<div class="text-xs text-slate-500">Failed to load profile data.</div>`;
                return;
            }

            const tiersList = GAMEMODES.filter(m => m.id !== 'overall').map(m => {
                const cur = getPlayerTier(data, m);
                const peak = getPlayerPeakTier(data, m);
                return `
                    <div class="glass-panel p-3.5 rounded-2xl border border-white/5 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid ${m.icon} text-xs text-slate-400"></i>
                            <span class="font-bold text-slate-200 text-xs">${m.name}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            ${cur ? `<span class="tier-badge tier-${cur.toLowerCase()}">${cur}</span>` : `<span class="text-xs text-slate-600 font-semibold">${I18N[currentLang].noTier}</span>`}
                            ${peak && peak !== cur ? `<span class="text-[10px] text-slate-500 font-mono">(Peak: ${peak})</span>` : ''}
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = `
                <div class="grid grid-cols-2 gap-3">
                    <div class="glass-panel p-4 rounded-2xl border border-white/5">
                        <div class="text-slate-400 text-[10px] sm:text-xs font-bold uppercase tracking-wider">Overall Score</div>
                        <div class="text-xl sm:text-2xl font-black text-white mt-1">${data.overallScore || 0}</div>
                    </div>
                    <div class="glass-panel p-4 rounded-2xl border border-white/5">
                        <div class="text-slate-400 text-[10px] sm:text-xs font-bold uppercase tracking-wider">Rank</div>
                        <div class="text-xl sm:text-2xl font-black text-white mt-1">#${data.rank || 'N/A'}</div>
                    </div>
                </div>

                <div class="space-y-3 pt-1">
                    <h4 class="text-xs font-black uppercase tracking-widest text-slate-400">Tiers</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        ${tiersList}
                    </div>
                </div>
            `;
        }

        async function openPlayerModal(identifier) {
            const modal = document.getElementById('playerModal');
            const container = document.getElementById('playerModalContent');
            modal.classList.remove('hidden');

            container.innerHTML = `<div class="p-12 text-center text-slate-400"><i class="fa-solid fa-circle-notch fa-spin text-3xl mb-3 text-white"></i><p class="text-xs font-bold">Loading player card...</p></div>`;

            let p = await fetchPlayerData(identifier) || leaderboardData.find(x => x.discordId === identifier || x.nickname === identifier);

            if (!p) {
                container.innerHTML = `<div class="p-6 text-center text-red-400 font-bold">Player not found.</div>`;
                return;
            }

            const nick = p.nickname || 'Steve';

            const tiersList = GAMEMODES.filter(m => m.id !== 'overall').map(m => {
                const cur = getPlayerTier(p, m);
                const peak = getPlayerPeakTier(p, m);
                return `
                    <div class="glass-panel p-2.5 rounded-xl border border-white/5 flex items-center justify-between text-xs">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid ${m.icon} text-xs text-slate-400"></i>
                            <span class="font-bold text-slate-300">${m.name}</span>
                        </div>
                        <div class="flex items-center gap-2">
                            ${cur ? `<span class="tier-badge tier-${cur.toLowerCase()}">${cur}</span>` : '<span class="text-slate-600 font-medium">-</span>'}
                            ${peak && peak !== cur ? `<span class="text-[10px] text-slate-500 font-mono">(Peak: ${peak})</span>` : ''}
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = `
                <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
                    <div class="flex flex-col items-center justify-center glass-panel p-4 rounded-3xl border border-white/10 min-w-[180px] w-full sm:w-auto relative overflow-hidden">
                        <canvas id="skinContainer3d" class="w-40 h-52 cursor-grab active:cursor-grabbing"></canvas>
                        <div class="text-[10px] text-slate-500 font-semibold mb-2">3D View</div>
                        <span class="text-[10px] px-3 py-1 rounded-xl font-bold ${p.accountType === 'licensed' ? 'bg-white/10 text-white border border-white/20' : 'bg-white/5 text-slate-400'}">
                            ${p.accountType === 'licensed' ? I18N[currentLang].license : I18N[currentLang].pirate}
                        </span>
                    </div>

                    <div class="flex-1 space-y-4 w-full">
                        <div>
                            <div class="flex items-center justify-between gap-2">
                                <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">${nick}</h2>
                                <span class="text-[11px] text-white font-black bg-white/10 px-2.5 py-1 rounded-full border border-white/20">
                                    Overall Rank #${p.rank || 'N/A'}
                                </span>
                            </div>
                            <p class="text-xs font-mono text-slate-500 mt-0.5">Discord ID: ${p.discordId}</p>
                        </div>

                        <div class="grid grid-cols-2 gap-2.5 text-xs">
                            <div class="glass-panel p-3 rounded-2xl border border-white/5">
                                <div class="text-slate-500 font-bold uppercase text-[9px]">Overall Score</div>
                                <div class="text-lg font-black text-white mt-0.5">${p.overallScore || 0}</div>
                            </div>
                            <div class="glass-panel p-3 rounded-2xl border border-white/5">
                                <div class="text-slate-500 font-bold uppercase text-[9px]">${I18N[currentLang].status}</div>
                                <div class="text-lg font-black ${p.restricted ? 'text-red-400' : 'text-emerald-400'} mt-0.5">
                                    ${p.restricted ? 'Restricted' : 'Active'}
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <h4 class="text-[10px] font-black uppercase tracking-widest text-slate-400">Tiers</h4>
                            <div class="grid grid-cols-1 gap-1.5 max-h-40 overflow-y-auto custom-scrollbar pr-1">
                                ${tiersList}
                            </div>
                        </div>
                    </div>
                </div>
            `;

            setTimeout(() => {
                try {
                    const canvas = document.getElementById('skinContainer3d');
                    skinViewerInstance = new skinview3d.SkinViewer({
                        canvas: canvas,
                        width: 160,
                        height: 200,
                        skin: `https://mc-heads.net/skin/${nick}`
                    });
                    
                    skinViewerInstance.fov = 70;
                    skinViewerInstance.zoom = 0.9;
                    skinViewerInstance.animation = new skinview3d.WalkingAnimation();
                    skinViewerInstance.animation.speed = 0.6;
                } catch (err) {
                    console.warn("3D Skin failed to load:", err);
                }
            }, 50);
        }

        async function fetchPlayerData(identifier) {
            if (playersCache[identifier]) return playersCache[identifier];
            try {
                const res = await fetch(`${API_BASE}/players/${identifier}`);
                if (!res.ok) return null;
                const data = await res.json();
                playersCache[identifier] = data;
                return data;
            } catch { return null; }
        }

        function closePlayerModal() { 
            document.getElementById('playerModal').classList.add('hidden');
            if (skinViewerInstance) {
                skinViewerInstance.dispose();
                skinViewerInstance = null;
            }
        }
        
        function toggleDiscordModal() { document.getElementById('discordModal').classList.toggle('hidden'); }
        
        function renderDiscordList() {
            document.getElementById('discordList').innerHTML = DISCORDS.map(d => `
                <div class="glass-panel p-3.5 rounded-2xl flex items-center justify-between border border-white/5">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid ${d.icon} text-slate-300"></i>
                        <div>
                            <div class="font-bold text-xs sm:text-sm text-white">${d.name}</div>
                            <div class="text-[10px] font-mono text-slate-500">ID: ${d.id}</div>
                        </div>
                    </div>
                    <a href="${d.invite}" target="_blank" class="bg-white hover:bg-slate-200 text-black text-xs px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl font-extrabold transition shadow-md">${I18N[currentLang].joinBtn}</a>
                </div>
            `).join('');
        }

        async function handleSearch(query) {
            const resultsBox = document.getElementById('searchResults');
            if (query.trim().length < 2) { resultsBox.classList.add('hidden'); return; }

            const filtered = leaderboardData.filter(p => 
                (p.nickname && p.nickname.toLowerCase().includes(query.toLowerCase())) ||
                (p.discordId && p.discordId.includes(query))
            );

            if (filtered.length > 0) {
                resultsBox.innerHTML = filtered.map(p => `
                    <div onclick="openPlayerModal('${p.discordId}'); document.getElementById('searchResults').classList.add('hidden');" 
                        class="p-3 hover:bg-white/5 cursor-pointer flex items-center justify-between border-b border-white/5 last:border-0 transition">
                        <span class="font-bold text-xs text-white">${p.nickname}</span>
                        <span class="text-[10px] font-mono text-slate-500">ID: ${p.discordId}</span>
                    </div>
                `).join('');
                resultsBox.classList.remove('hidden');
            } else {
                resultsBox.innerHTML = `<div class="p-3 text-xs text-slate-500 text-center font-medium">Ничего не найдено</div>`;
                resultsBox.classList.remove('hidden');
            }
        }

        function getDemoData() {
            return [];
        }
    </script>
</body>
</html>
